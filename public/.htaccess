<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # SEO endpoints are generated by Laravel. Never serve stale static files.
    RewriteRule ^(?:sitemap\.xml|robots\.txt)$ index.php [L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Los recursos publicados no cambian durante una visita. Se cachean sin afectar
# respuestas dinámicas de Laravel ni requerir que las cookies sean compartidas.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:avif|webp|jpe?g|png|svg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(?:css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.(?:woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <Files "bootstrap-5.3.2.min.css">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </Files>
    <Files "home-non-critical-v1.min.css">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </Files>
    <Files "home-framework-v1.min.css">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </Files>
    <Files "landing-shared-v1.min.css">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </Files>
    <Files "landing-footer-v1.min.css">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </Files>
</IfModule>

# Conserva el tamaño transferido de los assets locales equivalente al CDN.
# Apache solo lo aplica si mod_deflate está habilitado en el servidor.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css text/plain text/html text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
